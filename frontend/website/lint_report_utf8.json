}\r\n             animate={{ opacity: 1, y: 0 }}\r\n             className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#4A6741]/20 border border-[#4A6741]/30 text-[#4A6741] text-xs font-bold tracking-widest uppercase mb-6\"\r\n          >\r\n             <Leaf size={12} /> Since 2020\r\n          </motion.div>\r\n          <motion.h1 \r\n             initial={{ opacity: 0, y: 30 }}\r\n             animate={{ opacity: 1, y: 0 }}\r\n             transition={{ delay: 0.1 }}\r\n             className=\"font-heading font-black text-5xl md:text-7xl mb-6\"\r\n          >\r\n             Rooted in <span className=\"text-[#4A6741]\">Trust.</span>\r\n          </motion.h1>\r\n          <motion.p \r\n             initial={{ opacity: 0, y: 30 }}\r\n             animate={{ opacity: 1, y: 0 }}\r\n             transition={{ delay: 0.2 }}\r\n             className=\"text-xl text-white/80 leading-relaxed max-w-2xl mx-auto\"\r\n          >\r\n             We are a collective of farmers, technologists, and food lovers on a mission to fix the broken food system.\r\n          </motion.p>\r\n        </div>\r\n      </section>\r\n\r\n      {/* Mission Section */}\r\n      <section className=\"py-24 px-6 max-w-7xl mx-auto\">\r\n         <div className=\"grid md:grid-cols-2 gap-16 items-center\">\r\n            <div>\r\n               <h2 className=\"font-heading font-bold text-4xl text-[#262A2B] mb-6\">\r\n                  It started with a simple question: <br/>\r\n                  <span className=\"text-[#4A6741]\">\"Where does this come from?\"</span>\r\n               </h2>\r\n               <div className=\"space-y-6 text-[#262A2B]/70 text-lg leading-relaxed\">\r\n                  <p>\r\n                    In a world of mass production, \"organic\" became just another label. We wanted to bring back the connection. The handshake between the grower and the eater.\r\n                  </p>\r\n                  <p>\r\n                    NextGen Organics isn't just a store. It's an ecosystem. We empower small-scale farmers with technology and give you transparency you can actually verify.\r\n                  </p>\r\n               </div>\r\n            </div>\r\n            <div className=\"relative h-[500px] rounded-[2rem] overflow-hidden shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-500\">\r\n               <Image \r\n                  src=\"/hero-farm.jpg\" \r\n                  alt=\"Farmer Handshake\" \r\n                  fill\r\n                  className=\"object-cover\"\r\n               />\r\n            </div>\r\n         </div>\r\n      </section>\r\n\r\n      {/* Values Grid */}\r\n      <section className=\"py-24 bg-white\">\r\n         <div className=\"max-w-7xl mx-auto px-6\">\r\n            <div className=\"text-center mb-16\">\r\n               <h2 className=\"font-heading font-bold text-4xl text-[#262A2B]\">Our Core Values</h2>\r\n            </div>\r\n            <div className=\"grid md:grid-cols-3 gap-8\">\r\n               {[\r\n                  { icon: Award, title: \"Uncompromising Quality\", text: \"We don't do 'good enough'. If it's not nutrient-dense and chemical-free, it doesn't leave the farm.\" },\r\n                  { icon: Users, title: \"Farmer First\", text: \"We pay our farmers above market rates, ensuring they thrive so your food can thrive.\" },\r\n                  { icon: Heart, title: \"Community Driven\", text: \"Food brings people together. We are building a community of conscious consumers.\" }\r\n               ].map((item, i) => (\r\n                  <div key={i} className=\"p-8 rounded-3xl bg-[#F5F5F0] hover:bg-[#F0FDF4] transition-colors duration-300\">\r\n                     <div className=\"w-12 h-12 rounded-full bg-[#4A6741] text-white flex items-center justify-center mb-6\">\r\n                        <item.icon size={24} />\r\n                     </div>\r\n                     <h3 className=\"font-heading font-bold text-xl text-[#262A2B] mb-3\">{item.title}</h3>\r\n                     <p className=\"text-[#262A2B]/70\">{item.text}</p>\r\n                  </div>\r\n               ))}\r\n            </div>\r\n         </div>\r\n      </section>\r\n\r\n      {/* Stats Reuse */}\r\n      <ImpactStats />\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gunny\\development\\Nextgen-organic\\frontend\\website\\src\\app\\(marketing)\\contact\\page.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":13,"column":18,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[514,572],"text":"\r\n               We&apos;d love to hear from you.\r\n            "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[514,572],"text":"\r\n               We&lsquo;d love to hear from you.\r\n            "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[514,572],"text":"\r\n               We&#39;d love to hear from you.\r\n            "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[514,572],"text":"\r\n               We&rsquo;d love to hear from you.\r\n            "},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\n\r\nimport { Mail, MapPin, Phone } from \"lucide-react\";\r\n\r\nexport default function ContactPage() {\r\n  return (\r\n    <div className=\"bg-[#F5F5F0] min-h-screen pt-40 pb-24\">\r\n      <div className=\"max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16\">\r\n         {/* Info */}\r\n         <div>\r\n            <span className=\"text-[#4A6741] font-bold tracking-widest text-sm uppercase mb-4 block\">Get in Touch</span>\r\n            <h1 className=\"font-heading font-black text-5xl md:text-6xl text-[#262A2B] mb-8\">\r\n               We'd love to hear from you.\r\n            </h1>\r\n            <p className=\"text-xl text-[#262A2B]/60 mb-12\">\r\n               Have a question about our farms? Want to become a partner? Just want to say hi? Drop us a line.\r\n            </p>\r\n\r\n            <div className=\"space-y-8\">\r\n               {[\r\n                  { icon: Mail, label: \"Email\", val: \"hello@next360organics.in\" },\r\n                  { icon: Phone, label: \"Phone\", val: \"+91 40-1234-5678\" },\r\n                  { icon: MapPin, label: \"HQ\", val: \"Hitech City, Hyderabad\" }\r\n               ].map((item, i) => (\r\n                  <div key={i} className=\"flex items-center gap-4\">\r\n                     <div className=\"w-12 h-12 rounded-full bg-white border border-[#262A2B]/10 flex items-center justify-center text-[#4A6741]\">\r\n                        <item.icon size={20} />\r\n                     </div>\r\n                     <div>\r\n                        <div className=\"text-sm font-bold text-[#262A2B]/40 uppercase tracking-widest\">{item.label}</div>\r\n                        <div className=\"text-xl font-medium text-[#262A2B]\">{item.val}</div>\r\n                     </div>\r\n                  </div>\r\n               ))}\r\n            </div>\r\n         </div>\r\n\r\n         {/* Form */}\r\n         <div className=\"bg-white p-10 rounded-[2.5rem] shadow-xl shadow-[#262A2B]/5\">\r\n            <form className=\"space-y-6\">\r\n               <div className=\"grid md:grid-cols-2 gap-6\">\r\n                  <div className=\"space-y-2\">\r\n                     <label className=\"text-sm font-bold text-[#262A2B]\">First Name</label>\r\n                     <input type=\"text\" className=\"w-full px-4 py-3 rounded-xl bg-[#F5F5F0] border-transparent focus:bg-white focus:border-[#4A6741] focus:ring-1 focus:ring-[#4A6741] transition-all outline-none\" placeholder=\"John\" />\r\n                  </div>\r\n                  <div className=\"space-y-2\">\r\n                     <label className=\"text-sm font-bold text-[#262A2B]\">Last Name</label>\r\n                     <input type=\"text\" className=\"w-full px-4 py-3 rounded-xl bg-[#F5F5F0] border-transparent focus:bg-white focus:border-[#4A6741] focus:ring-1 focus:ring-[#4A6741] transition-all outline-none\" placeholder=\"Doe\" />\r\n                  </div>\r\n               </div>\r\n               <div className=\"space-y-2\">\r\n                  <label className=\"text-sm font-bold text-[#262A2B]\">Email</label>\r\n                  <input type=\"email\" className=\"w-full px-4 py-3 rounded-xl bg-[#F5F5F0] border-transparent focus:bg-white focus:border-[#4A6741] focus:ring-1 focus:ring-[#4A6741] transition-all outline-none\" placeholder=\"john@example.com\" />\r\n               </div>\r\n               <div className=\"space-y-2\">\r\n                  <label className=\"text-sm font-bold text-[#262A2B]\">Message</label>\r\n                  <textarea rows={4} className=\"w-full px-4 py-3 rounded-xl bg-[#F5F5F0] border-transparent focus:bg-white focus:border-[#4A6741] focus:ring-1 focus:ring-[#4A6741] transition-all outline-none\" placeholder=\"How can we help?\" />\r\n               </div>\r\n               <button type=\"submit\" className=\"w-full py-4 bg-[#262A2B] text-white font-bold rounded-xl hover:bg-[#4A6741] transition-colors\">\r\n                  Send Message\r\n               </button>\r\n            </form>\r\n         </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gunny\\development\\Nextgen-organic\\frontend\\website\\src\\app\\(marketing)\\how-it-works\\page.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Image' is defined but never used.","line":4,"column":8,"nodeType":"Identifier","messageId":"unusedVar","end