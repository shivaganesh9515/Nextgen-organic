ceable organic food delivered to your doorstep or neighborhood pick-up points.\"\r\n    }\r\n  ];\r\n\r\n  return (\r\n    <section className=\"py-24 bg-white relative overflow-hidden\">\r\n      <div className=\"container mx-auto px-6 relative z-10\">\r\n        <div className=\"text-center max-w-2xl mx-auto mb-16\">\r\n           <h2 className=\"text-sm font-bold text-[#65A30D] uppercase tracking-wider mb-3\">Our Ecosystem</h2>\r\n           <h3 className=\"text-4xl font-bold text-[#1a1c1e] mb-4\">From Soil to Soul</h3>\r\n           <p className=\"text-[#64748B] text-lg\">We've reimagined the food supply chain to be transparent, fair, and incredibly fast.</p>\r\n        </div>\r\n\r\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative\">\r\n           {/* Connector Line (Desktop) */}\r\n           <div className=\"hidden lg:block absolute top-12 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-[#BEF264] to-transparent z-0\" />\r\n\r\n           {steps.map((step, i) => (\r\n              <div key={i} className=\"relative z-10 bg-white p-6 rounded-3xl border border-gray-100 shadow-xl shadow-gray-200/50 hover:-translate-y-2 transition-transform duration-300\">\r\n                 <div className=\"w-16 h-16 rounded-2xl bg-[#BEF264] flex items-center justify-center text-[#1a1c1e] mb-6 shadow-lg shadow-[#BEF264]/30 mx-auto\">\r\n                    <step.icon size={32} strokeWidth={1.5} />\r\n                 </div>\r\n                 <h4 className=\"text-xl font-bold text-[#1a1c1e] mb-3 text-center\">{step.title}</h4>\r\n                 <p className=\"text-[#64748B] text-center leading-relaxed\">{step.desc}</p>\r\n                 \r\n                 {/* Step Number */}\r\n                 <div className=\"absolute top-4 right-4 text-xs font-bold text-[#65A30D] bg-[#65A30D]/10 px-2 py-1 rounded-full\">\r\n                    0{i + 1}\r\n                 </div>\r\n              </div>\r\n           ))}\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\gunny\\development\\Nextgen-organic\\frontend\\website\\src\\components\\sections\\WhyNext360.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Zap' is defined but never used.","line":1,"column":23,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":26,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Zap"},"fix":{"range":[20,25],"text":""},"desc":"Remove unused variable \"Zap\"."}]},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":23,"column":24,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[1287,1487],"text":"\r\n                 We don&apos;t just aggregate produce; we verify it. Our proprietary traceability engine ensures every bite you take is cleaner, safer, and supports a real farming family.\r\n              "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[1287,1487],"text":"\r\n                 We don&lsquo;t just aggregate produce; we verify it. Our proprietary traceability engine ensures every bite you take is cleaner, safer, and supports a real farming family.\r\n              "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[1287,1487],"text":"\r\n                 We don&#39;t just aggregate produce; we verify it. Our proprietary traceability engine ensures every bite you take is cleaner, safer, and supports a real farming family.\r\n              "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[1287,1487],"text":"\r\n                 We don&rsquo;t just aggregate produce; we verify it. Our proprietary traceability engine ensures every bi